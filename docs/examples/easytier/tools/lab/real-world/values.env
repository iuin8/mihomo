# 端到端重放参数（**全部为实验值，脱敏 ✓ 可直接入库 ✓**）
# 生产值不要写在这里 ✗ —— 用 `VALUES=/path/to/your.env ./replay.sh` 覆盖 ✓
LAB_NAME=etlab
NETWORK_NAME=lab-overlay
NETWORK_SECRET=lab-secret-please-change
RENDEZVOUS_HOST=rendezvous
RENDEZVOUS_PORT=11010

# overlay 内部地址（通用占位 ✓）
GW_IPV4=10.144.0.2/24
CLIENT_IPV4=10.144.0.6/24

# 两侧局域网（lab 网段 ✓ —— 生产改成你自己的 ✓）
HOME_LAN=10.99.1.0/24
CLIENT_LAN=10.99.2.0/24
GW_OVERLAY_IP=10.144.0.2
CLIENT_OVERLAY_IP=10.144.0.6

# 是否启用 TUN（真实验证必须为 true ✓；macOS 的 Docker 只能跑 false ✗）
USE_TUN=false
