# 在`~/.ssh/config`中配置, 或者`Include`这个配置文件(这样可以分多个配置文件去管理)

# 隧道连接专用配置
# 对于关键隧道连接，可以考虑使用 autossh 实现自动重连： autossh -M 0 -f -N -W localhost:22 container.fa.xxx
Host container.fa.xxx cpolar.* cloudflared.* tunnel.*
  ServerAliveInterval 60
  ServerAliveCountMax 30
  ControlPersist 3h
  TCPKeepAlive yes
  # UseDNS no
  # 确保转发失败时立即退出
  ExitOnForwardFailure yes
  ConnectTimeout 30
  ConnectionAttempts 3
  # 优化加密算法提升性能
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
  KexAlgorithms curve25519-sha256@libssh.org,ecdh-sha2-nistp521
# 隧道连接专用配置
Host cpolar.* cloudflared.*
    # 启用压缩（带宽有限时）
    Compression yes
# 开发环境​
Host dev.*
  Compression yes
  ControlPersist 1h
  # 提高连接速度的, 但是相对没那么安全
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
# 测试环境​
Host test.*
  Compression yes
  ControlPersist 1h
# 生产环境​
Host prod.*
  ControlPersist 10m
  StrictHostKeyChecking yes
# 代码管理相关
Host git*
  Compression yes
  ControlPersist 3h
# 全局配置​
Host *
  ServerAliveInterval 30
  ServerAliveCountMax 5
  # 连接复用​
  ControlMaster auto
  ControlPath ~/.ssh/control:%C
  ControlPersist 15m
  # 性能优化​
  Compression no
  GSSAPIAuthentication no
  # 需要配合服务端的 UseDNS 配置, 否则会报错
  # UseDNS no
  # 额外优化​
  TCPKeepAlive yes
  ConnectTimeout 10
